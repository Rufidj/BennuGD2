+#define GLTF_TEX_CACHE_MAX 512
+typedef struct { char key[1024]; G3DTexture *tex; } GltfTexCacheEntry;
+static GltfTexCacheEntry g_gltf_tex_cache[GLTF_TEX_CACHE_MAX];
